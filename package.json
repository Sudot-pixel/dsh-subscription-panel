{
  "name": "dsh-subscription-panel",
  "version": "0.2.9",
  "type": "module",
  "description": "DSH 订阅与额度面板：左栏底部入口 + 自绘玻璃浮层，展示各 AI 平台的余额/到期/用量/窗口进度，并提供续费深链、续费清单与归档删除。",
  "license": "MIT",
  "files": ["AGENTS.md", "README.md", "cordis.patch.yml", "package.json", "lib/host2.js", "lib/ui2.js"],
  "main": "lib/host2.js",
  "exports": {
    ".": {
      "default": "./lib/host2.js"
    },
    "./client": {
      "default": "./lib/ui2.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.2 || ^0.2.0-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "subscription",
    "quota",
    "usage"
  ]
}
